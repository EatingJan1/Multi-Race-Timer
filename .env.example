# Flask & Application Security
# MUST be set to a strong random 64-character secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=

# Admin User Initialization
ADMIN_USER=admin
ADMIN_PASS=

# Runtime Environment (production / development)
FLASK_ENV=production
SESSION_COOKIE_SECURE=false

# CORS Allowed Origins (comma-separated list if needed, or leave default for same-origin)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# Limits
MAX_PDF_SIZE_BYTES=5242880
SESSION_TTL_HOURS=12

# Self Update Feature (disabled by default in Docker)
DISABLE_SELF_UPDATE=true
